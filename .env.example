# ==============================================================================
# MAILBOXER CORE MULTI-ACCOUNT CONFIGURATION & CREDENTIALS TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the client or running verification:
#   cp .env.example .env
#
# SECURITY & COMPLIANCE RULES:
# 1. NEVER commit your real .env file or credentials to version control.
#    (.env is included in .gitignore by default).
# 2. NEVER use your primary master account password for Google or Apple.
#    Use provider-specific App Passwords generated from the links below.
# 3. Mailboxer automatically detects template placeholders (e.g., values
#    starting with "your.") and will guide you if real credentials are missing.
# ==============================================================================

# ==============================================================================
# 1. GOOGLE MAIL (GMAIL / GOOGLE WORKSPACE)
# ==============================================================================
# Step-by-Step Setup Instructions:
# 1. Enable 2-Step Verification:
#    - Visit: https://myaccount.google.com/security
#    - Confirm that "2-Step Verification" is turned ON.
# 2. Generate an App Password:
#    - Visit: https://myaccount.google.com/apppasswords
#    - Enter an App name: "Mailboxer" -> Click "Create".
#    - Google will display a 16-character code (e.g., "abcd efgh ijkl mnop").
#    - Copy this 16-character code into GMAIL_APP_PASSWORD below.
#      (Spaces and hyphens are automatically sanitized by Mailboxer).
# 3. CRITICAL: Enable IMAP in Gmail Web Settings:
#    - Open Gmail in your web browser (https://mail.google.com).
#    - Click the Settings gear icon (top right) -> "See all settings".
#    - Select the "Forwarding and POP/IMAP" tab.
#    - In the "IMAP access" section, select "Enable IMAP".
#    - Click "Save Changes" at the bottom of the page.
#    - Failure to do this causes Gmail to reject connections with
#      "[ALERT] Web login required" even with a valid app password.
# ------------------------------------------------------------------------------
GMAIL_ENABLED=true
GMAIL_EMAIL=your.account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional Gmail overrides (defaults to preset: imap.gmail.com:993 / smtp.gmail.com:587):
# GMAIL_LABEL="Google Mail"
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587


# ==============================================================================
# 2. APPLE MAIL (ICLOUD / ME.COM / MAC.COM)
# ==============================================================================
# Step-by-Step Setup Instructions:
# 1. Sign in to your Apple ID management portal:
#    - Visit: https://appleid.apple.com
# 2. Navigate to App-Specific Passwords:
#    - Click "Sign-In and Security" in the left sidebar.
#    - Select "App-Specific Passwords".
# 3. Generate a New Password:
#    - Click "Generate an app-specific password" (or the '+' icon).
#    - Enter label: "Mailboxer".
#    - Complete the 2FA prompt on your Apple device.
#    - Copy the generated 16-character code (e.g., "abcd-efgh-ijkl-mnop").
# 4. CRITICAL Apple Notes:
#    - Apple STRICTLY rejects primary account passwords when 2FA is active.
#      Master passwords fail immediately with "[AUTHENTICATIONFAILED]".
#    - Use your complete Apple ID address (e.g. user@icloud.com, user@me.com,
#      user@mac.com, or custom iCloud+ domain).
#    - IMAP connection uses implicit SSL/TLS on port 993 (imap.mail.me.com).
# ------------------------------------------------------------------------------
APPLE_ENABLED=true
APPLE_EMAIL=your.account@icloud.com
APPLE_APP_PASSWORD=your-16-char-apple-password

# Optional Apple overrides (defaults to preset: imap.mail.me.com:993 / smtp.mail.me.com:587):
# APPLE_LABEL="Apple Mail (iCloud)"
# APPLE_IMAP_HOST=imap.mail.me.com
# APPLE_IMAP_PORT=993
# APPLE_SMTP_HOST=smtp.mail.me.com
# APPLE_SMTP_PORT=587


# ==============================================================================
# 3. MICROSOFT OUTLOOK / OFFICE 365 (UNIVERSITY / ENTERPRISE / PERSONAL)
# ==============================================================================
# Step-by-Step Setup Instructions:
#
# Option A: University / School / Enterprise Microsoft 365 (Entra ID):
#   1. Visit your account security portal: https://myaccount.microsoft.com/
#   2. Navigate to "Security info" in the left navigation.
#   3. Click "+ Add sign-in method" -> select "App password" from dropdown.
#   4. Enter label: "Mailboxer" -> Save the generated password.
#   * NOTE ON UNIVERSITY / TENANT POLICIES:
#     Many educational institutions disable Basic Authentication for IMAP
#     via Microsoft Entra Conditional Access policies. If connection fails with:
#     "NO [AUTHENTICATIONFAILED] Basic authentication is disabled for this tenant."
#     contact your university IT Helpdesk to request IMAP access.
#
# Option B: Personal Outlook.com / Hotmail / Live Account:
#   1. Visit: https://account.live.com/proofs/manage/additional
#   2. Under "App passwords", click "Create a new app password".
#   3. Copy the password into OUTLOOK_PASSWORD below.
# ------------------------------------------------------------------------------
OUTLOOK_ENABLED=true
OUTLOOK_EMAIL=your.student.id@university.edu
OUTLOOK_PASSWORD=your_university_app_password

# Optional Outlook overrides (defaults to preset: outlook.office365.com:993 / smtp.office365.com:587):
# OUTLOOK_LABEL="University Outlook"
# OUTLOOK_IMAP_HOST=outlook.office365.com
# OUTLOOK_IMAP_PORT=993
# OUTLOOK_SMTP_HOST=smtp.office365.com
# OUTLOOK_SMTP_PORT=587


# ==============================================================================
# 4. OPTIONAL CUSTOM IMAP / SMTP ACCOUNT
# ==============================================================================
# Configure any standard IMAP/SMTP provider (Fastmail, Proton Bridge, self-hosted):
# ------------------------------------------------------------------------------
CUSTOM_ENABLED=false
# CUSTOM_LABEL="Custom Mail Server"
# CUSTOM_EMAIL=user@customdomain.com
# CUSTOM_PASSWORD=your_custom_password
# CUSTOM_IMAP_HOST=mail.customdomain.com
# CUSTOM_IMAP_PORT=993
# CUSTOM_IMAP_SECURE=true
# CUSTOM_SMTP_HOST=mail.customdomain.com
# CUSTOM_SMTP_PORT=587
# CUSTOM_SMTP_SECURE=false


# ==============================================================================
# 5. GLOBAL CONNECTION, TIMEOUT & DIAGNOSTIC CONFIGURATION
# ==============================================================================
# Socket connection timeout in milliseconds (default: 10000ms = 10s)
MAILBOXER_TIMEOUT_MS=10000

# Authentication command timeout in milliseconds (default: 10000ms = 10s)
MAILBOXER_AUTH_TIMEOUT_MS=10000

# Diagnostic output verbosity: 'info', 'debug', 'warn', 'error' (default: info)
MAILBOXER_LOG_LEVEL=info


# ==============================================================================
# 6. WEB LOGIN & SECURITY (REQUIRED FOR ANY PUBLIC DEPLOYMENT)
# ==============================================================================
# Password for the web app. Every /api route needs it.
# With NODE_ENV=production and no password set, the API stays locked (503).
# Changing the password signs out every existing session.
MAILBOXER_PASSWORD=change-me-to-a-long-random-password

# Optional token for scripts: send "Authorization: Bearer <token>".
# MAILBOXER_API_TOKEN=

# Set to true when running behind a reverse proxy (Caddy, nginx) so login
# rate limiting uses the real client IP and cookies are marked Secure.
# TRUST_PROXY=true


# ==============================================================================
# 7. SYNC, LIVE UPDATES & PUBLIC URL
# ==============================================================================
# Folders to sync, comma separated. Default: INBOX only (one unified inbox).
# "*" syncs every regular folder but always skips Spam, Trash, Drafts, Sent
# and Gmail's All Mail so messages are not duplicated.
# MAILBOXER_SYNC_FOLDERS=INBOX

# Live new-mail detection over IMAP IDLE (default: true).
# MAILBOXER_IDLE=true

# Full sync interval in milliseconds (flags, deletions, backfill).
# Default: 300000 (5 min) with IDLE on, 60000 (1 min) with IDLE off.
# MAILBOXER_SYNC_INTERVAL_MS=300000

# Public address of this app, used for OAuth redirect URLs and links in
# notifications. Must match the redirect URI registered with Google/Microsoft.
# APP_BASE_URL=https://mail.example.com
