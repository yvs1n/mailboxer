{
  "name": "mailboxer",
  "version": "0.1.0",
  "description": "Core multi-account connection and verification engine unifying Gmail, Apple Mail (iCloud), and University (Outlook) accounts",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mailboxer-verify": "./bin/verify.js"
  },
  "scripts": {
    "start": "node bin/server.js",
    "server": "node bin/server.js",
    "test": "node --test --test-reporter=spec test/**/*.test.js",
    "test:unit": "node --test --test-reporter=spec test/unit/**/*.test.js",
    "test:integration": "node --test --test-reporter=spec test/integration/**/*.test.js",
    "verify": "node bin/verify.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "email",
    "imap",
    "smtp",
    "gmail",
    "icloud",
    "apple-mail",
    "outlook",
    "office365",
    "triage",
    "diagnostics"
